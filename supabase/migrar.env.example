# Copie este arquivo para supabase/migrar.env e preencha.
# migrar.env fica fora do Git. Não cole a service_role no site.

# Em cada projeto: Connect → Session pooler (porta 5432) ou conexão direta.
# Não use o pooler de transação (porta 6543): o pg_dump não funciona nele.
# Se a senha tiver @, # ou :, troque por código de URL (%40, %23, %3A).
ORIGEM_DB_URL=postgresql://postgres.PROJETO_ANTIGO:SENHA@aws-0-sa-east-1.pooler.supabase.com:5432/postgres
DESTINO_DB_URL=postgresql://postgres.PROJETO_NOVO:SENHA@aws-0-sa-east-1.pooler.supabase.com:5432/postgres

# Project Settings → API. A URL pública, sem barra no final.
ORIGEM_URL=https://PROJETO_ANTIGO.supabase.co
DESTINO_URL=https://PROJETO_NOVO.supabase.co

# Chave secret / service_role dos dois projetos. Não use a chave anon nem sb_publishable.
# Só é necessária quando existem imagens de trabalhos.
ORIGEM_SERVICE_ROLE=
DESTINO_SERVICE_ROLE=
